# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# office temp/lock files (e.g. opening docs/reference/*.xlsx locally)
~$*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / local tooling (개인 개발 환경)
.vscode/
.claude/

# PM 원본 문서 사본 — 대용량·비공개 문서라 팀 코드 저장소에서는 제외 (docs/fe-spike-01/**은 제외 대상 아님)
docs/reference/

# 로컬 성능 테스트용 실제 상세페이지 이미지 — 저장소에 올리지 않음
/perf-assets/
